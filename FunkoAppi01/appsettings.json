{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/funkoapp-.log",
          "rollingInterval": "Day"
        }
      }
    ]
  },
  "DatabaseSettings": {
    "Provider": "Sqlite",
    "ConnectionString": "Data Source=funkos.db"
  },
  "AllowedHosts": "*"
}
